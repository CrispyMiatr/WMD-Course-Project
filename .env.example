APP_NAME=WatchLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Permissions for Linux
WWWUSER=1000
WWWGROUP=1000

# Database
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# Drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Mail - see "emails" in storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@watchlog.test"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
